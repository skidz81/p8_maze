--game manager--
--todo: the state sys is a bad idea
--will require a ton of extra code
--maybe just a string variable?
game = {
	state = "null",
	
	init = function(self)
		--just for testing
		--setting state.playing to
		--true. game will launch
		--on menu
		self.state="playing"
	end,
	
	update = function(self)
		--testing--
		if btnp(4) then
			self.state=set_state(
						self.state)
		end
		----------
		
		if self.state=="playing" then
			player:update()
				
		end
		if self.state=="title" then
			gui.title:drw(player.pos.x,
							player.pos.y)
		cam:cam_title()
		end--endif
	end,
	
	draw = function(self)
			if self.state=="playing"
			 then
				
				--testing for camera--
				cam:upd(player.pos.x,
								player.pos.y)
				map()
				---------------------
				player:draw() 
				 
			end--end if
			if self.state=="title"
				then
				
				gui.title:drw(
							player.pos.x,
							player.pos.y)
			end--endif
	end--enddrw
}--endgame

--state mangr func-------------
function set_state(st)
	if st == "playing" then
		st="title" 
	elseif
		st=="title" then
			st="playing"
	end--endif
	return st
end
-->8
--physics--

physics = {
	solid_at = function(px,py)
		local tx=flr(px/8)
		local ty=flr(py/8)
		local tile = mget(tx, ty)
		return fget(tile, 0)
	end,
	
	t_collide = function(self, 
											px, py,
											pw, ph)
		tl=self.solid_at(px, py)
		tr=self.solid_at(px+pw,py)
		bl=self.solid_at(px, py+ph)
		br=self.solid_at(px+pw,
										 py+ph)
		return tl or tr or bl or br 	 
		end
}--end physics



