--gui-cam class--

gui = {
	title = {
		drw = function(self,px, py)
			local ps_x=px
			local ps_y=py
			print("paused",56,
								63,7)
		end
		
	},--endtitle
	
	menu = {
	
	}--endmenu
}--endgui

------------camera---------
cam = {
	x_offset = 63,
	y_offset = 63,
	cam_x = 0,
	cam_y = 0,
	
	init = function(self, px, py)
		
	end,
	
	upd = function(self, px, py)
		self.cam_x=px-self.x_offset
		self.cam_y=py-self.y_offset
		
		self.cam_x, 
		self.cam_y = c_cam(
					self.cam_x, 
					self.cam_y)
		camera(self.cam_x, self.cam_y)
		
	end,
	
	cam_title=function(self)
		camera(0, 0)
	end
}

function c_cam(_x, _y)
	local x_edge = 128*8
	local y_edge = 128*8

	if _x < 0 then _x = 0 end
	if _y < 0 then _y = 0 end
	if _x > x_edge then
		_x = x_edge end
	if _y > y_edge then
		_y = y_edge end
	
	return _x, _y 
end--endfunc


