--player class--
timer = 0
blip_t = 10

player = {
	pos = {
		x = 10,
		y = 10,
		facing=false
		}, --end pos
		
	len = 8,
	hgt = 8,
	sp = 1,
	spd = 1,
	mx = 0,
	my = 0,
	
	init = function(self)
	
	end,
	
	update = function(self)
		self.sp,timer=
			blip(timer,self.sp)
		
		set_input()
		apply_input(self)
	end,	
	draw = function(self)
				
		spr(self.sp, self.pos.x,
				self.pos.y,1,1,
				self.pos.facing)
	end
	
	
}--end player
--simple controls for deving--
function set_input()
	left = btn(0)
	right = btn(1)
	up = btn(2)
	down = btn(3)
	enter = btn(4)
end

function apply_input(p)
	p.mx=0
	p.my=0
	
	if left then
		p.mx-=player.spd
		p.pos.facing=true 
	end
	if right then
		p.mx+=player.spd
		p.pos.facing=false 
	end
	if up then
		p.my-=player.spd end
	if down then
		p.my+=player.spd end
	
	
	
	
	move(player)
	--------------------------
end
function move(o)
--x axis collisioncheck and move
	o.mx=max_spd(o.mx)
	local sx = sgn(o.mx)
	
	for i=1, abs(o.mx) do
		if not physics:t_collide(
					o.pos.x+sx,
					o.pos.y,
					o.len,
					o.hgt) then
			o.pos.x+=sx
		else
			o.mx=0
			break
		end--endif
	end--endloop
	--same on y axis
	o.my = max_spd(o.my)
	local sy = sgn(o.my)
	
	for i=1, abs(o.my) do
		
		if not physics:t_collide(
					o.pos.x,
					o.pos.y+sy,
					o.len,
					o.hgt) then
			o.pos.y+=sy
		else
			o.my=0
			break
		end--endif
	end--endfor
end

--helpers--
function max_spd(spd)
	if spd > 2 then spd=2 end
	if spd <-2 then spd=-2 end
	return spd
end

function blip(timer, sp)
	timer+=1
	if timer>blip_t and sp==1 then
		sp=2
		timer=0
	end--endif
	if timer>blip_t and sp==2 then
		sp=1
		timer=0
	end--endif
	return sp, timer		
end
